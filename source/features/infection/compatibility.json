  "contract": {
    "settings_layout": "opence_extended_options_v35",
    "options_bytes": "0x1C..0x2B of game_variant_options",
    "mode_byte_offset": "0x1C",
    "legacy_clients": "refuse admission (network_rules_host_takes_game_type); never downgrade to Slayer",
    "base_engine": "slayer",
    "teams": true,
    "mode": 2,
    "option_offsets": {
      "first_zombies": "0x1E",
      "zombie_speed": "0x1F",
      "skull_damage": "0x20",
      "zombie_respawn": "0x21",
      "countdown": "0x22",
      "zombie_shields": "0x23"
    },
    "state_replication": "network_infection.h messages (stateful: full and incremental snapshots)",
    "authority": "host",
    "status_note": "rewritten as an extension (a ruleset or general hooks): the engine reaches it only through extension_api.h",
    "host_selection": "config infection.host (+ infection.* options), team Slayer only",
    "state_validator": "source/features/infection/infection_state.h, tested by tools/tests/compat/infection_state_test.c",
    "menus": "OPENCE bank of Select Gametype lists the built-in gametypes (game_modes.c); options screen not brought over (config <mode>.* settings instead)"
  },
