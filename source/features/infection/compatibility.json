      "infection_wire_vectors": {
        "kind": "pytest",
        "id": "tools/test_compat_wire.py",
        "k": "vector or offsets",
        "what": "OpenCE's 16 option bytes at 0x1C..0x2B: mode, order, melee, Hardcore, sanitizing, engine/teams rules"
      },
      "infection_integration": {
        "kind": "pytest",
        "id": "tools/test_compat_wire.py",
        "k": "integration_points or engine_does_not_name or kind_is_advertised or keeps_slayer or stock_default",
        "what": "the engine's hooks and OPENCE menu wiring exist; stock profiles unchanged"
      },
      "infection_rules": {
        "kind": "pytest",
        "id": "tools/test_compat_wire.py",
        "k": "test_mode_rules and infection",
        "what": "the mode's rules as decisions on plain numbers: round result, first zombies, kills and infection, clock, winners, skull melee, zombie speed, state validation"
      },
      "infection_host_crossplay": {
        "kind": "manual",
        "what": "this build hosts, an OpenCE client plays a match"
      },
      "infection_client_crossplay": {
        "kind": "manual",
        "what": "an OpenCE host, this build joins and plays a match"
      },
      "infection_snapshot_malformed": {
        "kind": "pytest",
        "id": "tools/test_compat_wire.py",
        "k": "infection_state",
        "what": "the host's state as a client takes it: full, incremental, stale, duplicate, malformed"
      }
