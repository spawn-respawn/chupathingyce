  "contract": {
    "settings_layout": "opence_extended_options_v35",
    "options_bytes": "0x1C..0x2B of game_variant_options",
    "mode_byte_offset": "0x1C",
    "legacy_clients": "host refuses a machine taking the 13,120-byte record when an OpenCE mode is pending (network_server_message_handler.c)",
    "base_engine": "slayer",
    "teams": false,
    "mode": 3,
    "weapon_order_offset": "0x24",
    "weapon_order": {
      "0": "strongest_first",
      "1": "weakest_first",
      "2": "random_host_drawn"
    },
    "melee_demotes_offset": "0x25",
    "progression": "slayer_individual_score",
    "win": "score == weapon count",
    "score_replication": "slayer",
    "inventory_replication": "native_objects",
    "weapon_authority": "host",
    "pickups": "denied",
    "kill_path": "engine player_killed_player wrapper, not halo_ruleset.player_killed",
    "spawn_hook": "halo_ruleset.postspawn_player",
    "options_storage": "game_variant_extended_options beside the 0x1C game_variant_options (not one 0x2C struct); the network record is 35 layout via network_rules further options",
    "host_selection": "config gun_game.host (free for all Slayer only); no menu bank yet",
    "menus": "OPENCE bank of Select Gametype lists the built-in gametypes (game_modes.c); options screen not brought over (config <mode>.* settings instead)"
  },
